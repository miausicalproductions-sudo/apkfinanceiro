<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saldo total"
            android:textColor="#8b9bb0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5d6b7c"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="—"
        android:textColor="#e6edf3"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text=""
        android:textColor="#8b9bb0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wBtnSaida"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_saida"
            android:gravity="center"
            android:text="− Saída"
            android:textColor="#ff8f8f"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wBtnEntrada"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_entrada"
            android:gravity="center"
            android:text="+ Entrada"
            android:textColor="#5fe08f"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wBtnApp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_weight="0.6"
            android:background="@drawable/btn_app"
            android:gravity="center"
            android:text="Abrir"
            android:textColor="#c3cfdd"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
